<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nabira for Windows. No external (NuGet) dependencies. Low-level engine (LL hook,
       SendInput injection, tray) is raw Win32 P/Invoke; WinForms (first-party .NET) is used
       only for the clipboard and the settings window. EnableWindowsTargeting lets it also
       compile on macOS (P/Invoke compiles, can't run) for a fast local compile-check; the real
       build/test/exe come from the windows-latest CI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Nabira.Win</RootNamespace>
    <AssemblyName>Nabira</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- Windows track starts pre-1.0 (beta). Keep in sync with windows/version.json. -->
    <Version>0.10.0</Version>
    <ApplicationIcon>Resources\Nabira.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Let the test project reach internal engine types (AutoConverter verdict, etc.). -->
    <InternalsVisibleTo Include="Nabira.Win.Tests" />
    <EmbeddedResource Include="Resources\yoficator.tsv" LogicalName="Nabira.Yoficator.tsv" />
  </ItemGroup>

</Project>
