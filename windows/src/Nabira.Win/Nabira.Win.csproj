<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nabira for Windows. The low-level engine (LL hook, SendInput injection, tray) is raw
       Win32 P/Invoke; WinForms is used for the clipboard and settings, while ONNX Runtime is
       bundled for the optional local SAGE component. EnableWindowsTargeting keeps the project
       compile-checkable on macOS; real execution tests and EXE builds run on windows-latest. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Nabira.Win</RootNamespace>
    <AssemblyName>Nabira</AssemblyName>
    <AssemblyTitle>Nabira</AssemblyTitle>
    <Product>Nabira</Product>
    <Company>Nabira</Company>
    <Description>Nabira — умный помощник для набора текста</Description>
    <Copyright>Copyright © 2025 Rashns; modifications © 2026 Ivan Golotik</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- Keep in sync with windows/version.json. -->
    <Version>0.11.8</Version>
    <ApplicationIcon>Resources\Nabira.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project reach internal engine types (AutoConverter verdict, etc.). -->
    <InternalsVisibleTo Include="Nabira.Win.Tests" />
    <EmbeddedResource Include="Resources\yoficator.tsv" LogicalName="Nabira.Yoficator.tsv" />
    <EmbeddedResource Include="..\..\..\macos\Sources\Nabira\Resources\frequency_en_50k.txt" LogicalName="Nabira.frequency_en_50k.txt" />
    <EmbeddedResource Include="..\..\..\macos\Sources\Nabira\Resources\frequency_ru_50k.txt" LogicalName="Nabira.frequency_ru_50k.txt" />
    <EmbeddedResource Include="..\..\..\macos\Sources\Nabira\Resources\language_intent.onnx" LogicalName="Nabira.language_intent.onnx" />
    <EmbeddedResource Include="..\..\..\macos\Sources\Nabira\Resources\language_intent_dictionary.json" LogicalName="Nabira.language_intent_dictionary.json" />
  </ItemGroup>

</Project>
